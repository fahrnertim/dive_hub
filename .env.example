# Copy to .env for local development (.env is git-ignored).
DATABASE_URL=postgres://divehub:divehub-dev@127.0.0.1:5432/divehub
DIVEHUB_DATA_DIR=./data
DIVEHUB_PORT=3000
# Public URL users open; invitation links point here. The Vite dev server is on 5173.
DIVEHUB_BASE_URL=http://localhost:5173
# Optional: cookie signing secret (otherwise generated into DIVEHUB_DATA_DIR/auth-secret).
# DIVEHUB_AUTH_SECRET=
# Optional, for importing dive sites: your e-mail or URL, sent in the User-Agent to Overpass and Wikidata.
# DIVEHUB_CONTACT=
# Optional, for sending dives to SSI: 32 bytes as base64 (openssl rand -base64 32). Lets Users keep their SSI password, encrypted.
# DIVEHUB_ENCRYPTION_KEY=
