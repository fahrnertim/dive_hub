    "/api/dives": {
      "get": {
        "summary": "Dives of the Divers the current user manages, newest first",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "number",
                      "startsAt",
                      "utcOffsetSeconds",
                      "durationSeconds",
                      "maxDepthM",
                      "avgDepthM"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "number": {
                        "anyOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "startsAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "utcOffsetSeconds": {
                        "anyOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "durationSeconds": {
                        "type": "number"
                      },
                      "maxDepthM": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "avgDepthM": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/dives/{id}": {
      "get": {
        "summary": "One Dive with its Recordings",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "type": "object",
                      "required": [
                        "id",
                        "number",
                        "startsAt",
                        "utcOffsetSeconds",
                        "durationSeconds",
                        "maxDepthM",
                        "avgDepthM"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "number": {
                          "anyOf": [
                            {
                              "type": "integer"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "startsAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "utcOffsetSeconds": {
                          "anyOf": [
                            {
                              "type": "integer"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "durationSeconds": {
                          "type": "number"
                        },
                        "maxDepthM": {
                          "anyOf": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "avgDepthM": {
                          "anyOf": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "recordings"
                      ],
                      "properties": {
                        "recordings": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "id",
                              "isPrimary",
                              "startsAt",
                              "durationSeconds",
                              "maxDepthM",
                              "parser",
                              "summary",
                              "channels"
                            ],
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "isPrimary": {
                                "type": "boolean"
                              },
                              "startsAt": {
                                "type": "string",
                                "format": "date-time"
                              },
                              "durationSeconds": {
                                "type": "number"
                              },
                              "maxDepthM": {
                                "anyOf": [
                                  {
                                    "type": "number"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "parser": {
                                "type": "string"
                              },
                              "summary": {
                                "type": "object",
                                "additionalProperties": {}
                              },
                              "channels": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/recordings/{id}/samples": {
      "get": {
        "summary": "Sample series of a Recording, downsampled for display",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "channels",
            "required": false,
            "description": "Comma-separated channel names; default all"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 4,
              "maximum": 20000,
              "default": 2000
            },
            "in": "query",
            "name": "maxPoints",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "recordingId",
                    "series"
                  ],
                  "properties": {
                    "recordingId": {
                      "type": "string"
                    },
                    "series": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "channel",
                          "offsetsMs",
                          "values"
                        ],
                        "properties": {
                          "channel": {
                            "type": "string"
                          },
                          "offsetsMs": {
                            "type": "array",
                            "items": {
                              "type": "integer"
                            }
                          },
                          "values": {
                            "type": "array",
                            "items": {
                              "type": "number"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
