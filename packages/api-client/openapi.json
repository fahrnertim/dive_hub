                          {
                            "type": "string",
                            "enum": [
                              "failed"
                            ]
                          }
                        ]
                      },
                      "uploadName": {
                        "type": "string"
                      },
                      "createdAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "finishedAt": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "date-time"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "error": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "outcome": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "fileName",
                            "result"
                          ],
                          "properties": {
                            "fileName": {
                              "type": "string"
                            },
                            "result": {
                              "type": "string"
                            },
                            "diveId": {
                              "type": "string"
                            },
                            "recordingId": {
                              "type": "string"
                            },
                            "message": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
