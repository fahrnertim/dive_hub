    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fit-file-parser": "^6.1.2",
    "graphile-worker": "^0.18.0",
    "pg": "^8.23.1",
    "typebox": "^1.3.34",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@garmin/fitsdk": "^21.217.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "drizzle-kit": "^0.31.11",
    "tsup": "^8.5.1",
